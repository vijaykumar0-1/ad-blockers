{
  "manifest_version": 3,
  "name": "LocalBlock",
  "version": "0.2.0",
  "description": "A small, auditable ad blocker. Everything runs on your machine; nothing about your browsing is sent anywhere.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LocalBlock",
    "default_popup": "src/popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base",
        "enabled": true,
        "path": "rules/base.json"
      },
      {
        "id": "easylist",
        "enabled": true,
        "path": "rules/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "rules/easyprivacy.json"
      }
    ]
  }
}
